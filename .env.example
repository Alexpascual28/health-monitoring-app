# ============================================================================
# IoT Remote Health Monitoring Platform - Phase 1 MVP Configuration Template
# Copy this file to .env and fill in environment-specific values.
# ============================================================================

# Application & Cloud Region (Non-negotiable: UK Cloud Region)
NODE_ENV=development
CLOUD_REGION=eu-west-2
PORT=4000
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
MQTT_PORT=1883
MQTT_TLS_ENABLED=true
TLS_MIN_VERSION=TLSv1.2

# Default Pilot Care Centre (Phase 1 MVP: ~100 patients at 1 Care Centre)
DEFAULT_CARE_CENTRE_ID=cc-uk-sunrise-01
DEFAULT_CARE_CENTRE_NAME="Sunrise Senior Living - London Care Centre"

# Security, Authentication & Encryption (AES-256 + Key Rotation)
JWT_SECRET=replace-with-64-byte-vaulted-jwt-secret-key-in-production
ENCRYPTION_KEY_CURRENT_ID=key-v2-2026-11
ENCRYPTION_KEY_V2_AES256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_V1_AES256=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
STAFF_MFA_ISSUER="CarePulse24x7-UK"

# Wearable Device Provisioning & Rate Limiting
DEVICE_PROVISIONING_HMAC_SECRET=band-provisioning-root-secret-dev-only
DEVICE_RATE_LIMIT_PER_MIN=120
OUT_OF_ORDER_BUFFER_WINDOW_MS=300000

# Alerting & Multi-Channel Providers (SMS DLT, Voice, Push, Email)
SMS_PROVIDER_PRIMARY=twilio-uk-in-dlt
SMS_PROVIDER_FAILOVER=aws-sns-dlt
SMS_DLT_ENTITY_ID=1101582910000049281
SMS_DLT_CRITICAL_TEMPLATE_ID=1107169820000010001
SMS_API_KEY=mock-sms-api-key-dev
VOICE_PROVIDER_PRIMARY=twilio-voice-uk
VOICE_API_KEY=mock-voice-api-key-dev
PUSH_FCM_SERVER_KEY=mock-fcm-server-key-dev
EMAIL_SES_REGION=eu-west-2

# Maps & Geofencing
MAPS_PROVIDER=google-maps-uk
MAPS_API_KEY=mock-maps-api-key-dev
