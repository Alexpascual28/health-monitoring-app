{
  "name": "iot-remote-health-monitoring-platform",
  "version": "1.0.0",
  "description": "IoT Remote Health Monitoring Platform: Wearable Ingestion, Multi-Tenant Backend, 24x7 Caregiver Console, Family Mobile App & 5,000-Band Simulator (Phase 1 MVP)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx src/server/index.ts",
    "dev:ui": "vite --port 5173",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sim:5000": "tsx src/simulator/sim-5000-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.6",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.6"
  }
}
